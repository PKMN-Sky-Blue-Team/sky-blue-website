# Gems needed to build the site locally exactly as GitHub Pages builds it.
# Run `./scripts/serve.sh` (or `bundle install`) to install them.
source "https://rubygems.org"

# Pins Jekyll and every plugin to the versions GitHub Pages uses in production.
gem "github-pages", group: :jekyll_plugins

# Ruby 3+ no longer bundles a web server; `jekyll serve` needs this one.
gem "webrick", "~> 1.8"
